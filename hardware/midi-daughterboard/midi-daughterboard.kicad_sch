(text "2 IN / 2 OUT MIDI DAUGHTERBOARD - ENGINEERING DRAFT" (at 15 12 0) (effects (font (size 1.3 1.3)) (justify left)) (uuid "b9523c22-6147-44a5-927b-72a05c937fa6"))
(text "Original Raspberry Pi Zero | 9 V centre-negative | TRS Type A | no PCB layout or ERC sign-off" (at 15 19 0) (effects (font (size 1.3 1.3)) (justify left)) (uuid "6d2b6704-be4d-4ed5-91b6-3ba9d4a7e7f5"))
(text "POWER: insulated jack; one power source only" (at 15 30 0) (effects (font (size 1.3 1.3)) (justify left)) (uuid "2e4fb583-bab1-445a-b475-06294f9a3e7e"))
(text "5.01 V nominal; feedback tolerance reviewed in README." (at 95 160 0) (effects (font (size 1.3 1.3)) (justify left)) (uuid "4d6d30e5-5552-483a-880f-b27efb8d7963"))
(text "No USB/pedal dual powering. Validate startup and ripple before attaching Pi." (at 15 172 0) (effects (font (size 1.3 1.3)) (justify left)) (uuid "af5642a2-e13f-461e-9d6d-3ceed4bad325"))
(text "PI HEADER / SPI / UART CLOCK" (at 315 30 0) (effects (font (size 1.3 1.3)) (justify left)) (uuid "5bb0966d-b906-40f6-9517-0bdec0ac74d2"))
(text "Divisor = 32, prescaler = 1, 8N1: 16 MHz / (16 x 32) = 31250 baud." (at 315 207 0) (effects (font (size 1.3 1.3)) (justify left)) (uuid "a8db5ae5-03d7-4d26-91c1-94330541b593"))
(text "ISOLATED INPUTS: sleeves unconnected; preserve LED-side isolation" (at 15 190 0) (effects (font (size 1.3 1.3)) (justify left)) (uuid "dc9fc45f-eabd-41b9-a0da-79a4431dcfe6"))
(text "LED on = RX low. No breath/controller-specific hardware filtering." (at 15 308 0) (effects (font (size 1.3 1.3)) (justify left)) (uuid "b4a212b8-1d92-4d8d-8f64-1e632f7ff78e"))
(text "OUTPUTS: 5 V current loops; 3.3 V noninverting open-drain driver" (at 315 231 0) (effects (font (size 1.3 1.3)) (justify left)) (uuid "71134b05-7bef-4a2a-86b4-f53a203d506e"))
(text "UART GPIO pulldowns (unused pins): do not enable modem/GPIO outputs" (at 15 331 0) (effects (font (size 1.3 1.3)) (justify left)) (uuid "4bd7b3f8-cfdb-4840-b005-ec75e6bf2558"))
(text "DRAFT: footprints intentionally unassigned. Independently review, open in KiCad and run ERC before PCB design." (at 15 400 0) (effects (font (size 1.3 1.3)) (justify left)) (uuid "0abad0e1-902f-4d34-baf5-34d613c6dcb2"))
